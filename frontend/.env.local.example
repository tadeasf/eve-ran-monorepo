# Application Configuration
# Set this to your corporation, squad, or group name
NEXT_PUBLIC_CORPORATION_NAME=Tundragon Corp

# API Configuration
NEXT_PUBLIC_API_URL=https://api.tundragon.space
NEXT_PUBLIC_API_KEY=your_api_key

# Admin Authentication (Server-side only - NOT exposed to client)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Authentication (for future JWT implementation)
NEXTAUTH_URL=https://tundragon.space
NEXTAUTH_SECRET=your_nextauth_secret
