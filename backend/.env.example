# Database Configuration
DB_NAME=your_database_name
DB_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# API Security
# Generate a secure random string for production
